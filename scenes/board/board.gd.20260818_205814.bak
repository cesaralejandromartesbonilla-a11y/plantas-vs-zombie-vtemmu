extends Node2D

## Board — Grilla de juego 9 columnas × 5 filas (Fase 1).
##
## Genera las celdas (instancias de cell.tscn), las posiciona en el mundo y
## mantiene el arreglo `cells[5][9]` que en fases posteriores guardará la
## referencia a la planta ocupante o null.
##
## Coordenadas de celda:
##   - col 0..8  (de izquierda a derecha)
##   - row 0..4  (de arriba a abajo)
##
## Tamaños (constantes del MVP):
##   - Celda: 80 x 100 px
##   - Board completo: 720 x 500 px
## El origen local (0,0) del Board coincide con su centro; el lado superior
## izquierdo está en -BOARD_SIZE/2.

signal cell_hovered(col: int, row: int)

const CELL_SIZE := Vector2(80, 100)
const COLS := 9
const ROWS := 5
const BOARD_SIZE := Vector2(CELL_SIZE.x * COLS, CELL_SIZE.y * ROWS)

const CELL_SCENE := preload("res://scenes/board/cell.tscn")

const COLOR_LAWN_A := Color(0.35, 0.75, 0.3, 1.0)
const COLOR_LAWN_B := Color(0.42, 0.78, 0.36, 1.0)
const COLOR_EDGE := Color(0.20, 0.45, 0.18, 1.0)

## cells[row][col] -> Cell (referencia al nodo).
var cells: Array = []

func _ready() -> void:
	_build_lawn_background()
	_build_cells()
	EventBus.cell_clicked.connect(_on_cell_clicked)

## Devuelve el centro LOCAL de la celda (col, row) dentro del Board.
func cell_center(col: int, row: int) -> Vector2:
	var top_left := -BOARD_SIZE / 2.0
	return top_left + Vector2(CELL_SIZE.x * (col + 0.5), CELL_SIZE.y * (row + 0.5))

## ¿La coordenada (col, row) es válida dentro del board?
func is_valid(col: int, row: int) -> bool:
	return col >= 0 and col < COLS and row >= 0 and row < ROWS

## La celda en (col, row) — null si fuera del tablero.
func get_cell(col: int, row: int) -> Area2D:
	if not is_valid(col, row):
		return null
	return cells[row][col]

## Convierte una posición del mundo a coordenadas de celda (col, row),
## o (-1, -1) si está fuera del tablero. Útil para previews en fases posteriores.
func world_to_cell(world_pos: Vector2) -> Vector2i:
	var local := to_local(world_pos) + BOARD_SIZE / 2.0
	var col := int(local.x / CELL_SIZE.x)
	var row := int(local.y / CELL_SIZE.y)
	if is_valid(col, row):
		return Vector2i(col, row)
	return Vector2i(-1, -1)

func _build_lawn_background() -> void:
	var top_left := -BOARD_SIZE / 2.0

	# Relleno principal.
	var lawn := ColorRect.new()
	lawn.size = BOARD_SIZE
	lawn.position = top_left
	lawn.color = COLOR_LAWN_A
	lawn.mouse_filter = Control.MOUSE_FILTER_IGNORE
	add_child(lawn)

	# Filas alternas más claras (efecto césped rayado).
	for row in ROWS:
		if row % 2 == 0:
			continue
		var stripe := ColorRect.new()
		stripe.size = Vector2(BOARD_SIZE.x, CELL_SIZE.y)
		stripe.position = top_left + Vector2(0.0, row * CELL_SIZE.y)
		stripe.color = COLOR_LAWN_B
		stripe.mouse_filter = Control.MOUSE_FILTER_IGNORE
		add_child(stripe)

	# Marco/borde (se dibuja detrás del césped).
	var edge := 4.0
	var frame := ColorRect.new()
	frame.size = BOARD_SIZE + Vector2(edge * 2.0, edge * 2.0)
	frame.position = top_left - Vector2(edge, edge)
	frame.color = COLOR_EDGE
	frame.mouse_filter = Control.MOUSE_FILTER_IGNORE
	add_child(frame)
	frame.move_to_back()

func _build_cells() -> void:
	for row in ROWS:
		var row_arr: Array = []
		for col in COLS:
			var cell: Area2D = CELL_SCENE.instantiate()
			cell.setup(col, row)
			cell.position = cell_center(col, row)
			add_child(cell)
			row_arr.append(cell)
		cells.append(row_arr)

func _on_cell_clicked(col: int, row: int) -> void:
	# Fase 1: validación y log de debug (criterio de aceptación).
	print("[Board] Celda clicada -> col=%d, fila=%d" % [col, row])