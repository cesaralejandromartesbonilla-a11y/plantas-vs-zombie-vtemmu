=== scenes\board\board.gd ===
  1: extends Node2D
  2: 
  3: ## Board — Grilla de juego 9 columnas × 5 filas (Fase 1).
  4: ##
  5: ## Genera las celdas (instancias de cell.tscn), las posiciona en el mundo y
  6: ## mantiene el arreglo `cells[5][9]` que en fases posteriores guardará la
  7: ## referencia a la planta ocupante o null.
  8: ##
  9: ## Coordenadas de celda:
 10: ##   - col 0..8  (de izquierda a derecha)
 11: ##   - row 0..4  (de arriba a abajo)
 12: ##
 13: ## Tamaños (constantes del MVP):
 14: ##   - Celda: 80 x 100 px
 15: ##   - Board completo: 720 x 500 px
 16: ## El origen local (0,0) del Board coincide con su centro; el lado superior
 17: ## izquierdo está en -BOARD_SIZE/2.
 18: 
 19: signal cell_hovered(col: int, row: int)
 20: 
 21: const CELL_SIZE := Vector2(80, 100)
 22: const COLS := 9
 23: const ROWS := 5
 24: const BOARD_SIZE := Vector2(CELL_SIZE.x * COLS, CELL_SIZE.y * ROWS)
 25: 
 26: const CELL_SCENE := preload("res://scenes/board/cell.tscn")
 27: 
 28: const COLOR_LAWN_A := Color(0.35, 0.75, 0.3, 1.0)
 29: const COLOR_LAWN_B := Color(0.42, 0.78, 0.36, 1.0)
 30: const COLOR_EDGE := Color(0.20, 0.45, 0.18, 1.0)
 31: 
 32: ## cells[row][col] -> Cell (referencia al nodo).
 33: var cells: Array = []
 34: 
 35: ## Semilla seleccionada (que está a la espera de click en una celda),
 36: ## o &"" si no hay ninguna. Una planta por celda la valida `can_plant`.
 37: var pending_seed: StringName = &""
 38: 
 39: func _ready() -> void:
 40: 	_build_lawn_background()
 41: 	_build_cells()
 42: 	EventBus.cell_clicked.connect(_on_cell_clicked)
 43: 	EventBus.seed_selected.connect(_on_seed_selected)
 44: 	EventBus.plant_destroyed.connect(_on_plant_destroyed)
 45: 	# Si cambia el saldo (p. ej. recoges sol), los previews se recalculan.
 46: 	EventBus.sun_changed.connect(func(_total: int) -> void: _refresh_previews())
 47: 
 48: ## Devuelve el centro LOCAL de la celda (col, row) dentro del Board.
 49: func cell_center(col: int, row: int) -> Vector2:
 50: 	var top_left := -BOARD_SIZE / 2.0
 51: 	return top_left + Vector2(CELL_SIZE.x * (col + 0.5), CELL_SIZE.y * (row + 0.5))
 52: 
 53: ## Devuelve el centro GLOBAL (mundo) de la celda (col, row).
 54: ## Útil para instanciar plantas/zombies dentro de otras escenas.
 55: func world_center(col: int, row: int) -> Vector2:
 56: 	return to_global(cell_center(col, row))
 57: 
 58: ## ¿La coordenada (col, row) es válida dentro del board?
 59: func is_valid(col: int, row: int) -> bool:
 60: 	return col >= 0 and col < COLS and row >= 0 and row < ROWS
 61: 
 62: ## La celda en (col, row) — null si fuera del tablero.
 63: func get_cell(col: int, row: int) -> Cell:
 64: 	if not is_valid(col, row):
 65: 		return null
 66: 	return cells[row][col]
 67: 
 68: ## Convierte una posición del mundo a coordenadas de celda (col, row),
 69: ## o (-1, -1) si está fuera del tablero. Útil para previews en fases posteriores.
 70: func world_to_cell(world_pos: Vector2) -> Vector2i:
 71: 	var local := to_local(world_pos) + BOARD_SIZE / 2.0
 72: 	var col := int(local.x / CELL_SIZE.x)
 73: 	var row := int(local.y / CELL_SIZE.y)
 74: 	if is_valid(col, row):
 75: 		return Vector2i(col, row)
 76: 	return Vector2i(-1, -1)
 77: 
 78: ## Planta que ocupa la celda (col, row), o null si está vacía.
 79: func plant_at(col: int, row: int) -> Plant:
 80: 	var cell: Cell = get_cell(col, row)
 81: 	if cell == null:
 82: 		return null
 83: 	return cell.plant
 84: 
 85: ## ¿Se puede plantar la semilla `seed_id` en esta celda?
 86: ## (Existe la semilla, la celda es válida y está vacía, y hay sol.)
 87: func can_plant(seed_id: StringName, col: int, row: int) -> bool:
 88: 	if seed_id == &"" or not PlantLibrary.has_seed(seed_id):
 89: 		return false
 90: 	if not is_valid(col, row):
 91: 		return false
 92: 	if plant_at(col, row) != null:
 93: 		return false
 94: 	return SunBank.can_afford(PlantLibrary.get_data(seed_id).cost)
 95: 
 96: ## Fase 3: instancia la planta de la semilla en la celda (col, row) y la
 97: ## registra. Devuelve la planta creada o null si no se pudo.
 98: func plant(seed_id: StringName, col: int, row: int) -> Plant:
 99: 	if not can_plant(seed_id, col, row):
100: 		return null
101: 	var scene: PackedScene = PlantLibrary.get_scene(seed_id)
102: 	if scene == null:
103: 		return null
104: 	var plant: Plant = scene.instantiate()
105: 	plant.setup(col, row)
106: 	plant.global_position = world_center(col, row)
107: 	# La añade al árbol ANTES de set_plant (los @onready de la planta corren).
108: 	get_tree().get_first_node_in_group("entities").add_child(plant)
109: 	_cell(col, row).set_plant(plant)
110: 	EventBus.plant_planted.emit(plant, col, row)
111: 	return plant
112: 
113: ## Registra la planta en su celda (público para que Main la inserte).
114: func register_plant(plant: Plant) -> void:
115: 	var cell: Cell = get_cell(plant.col, plant.row)
116: 	if cell:
117: 		cell.set_plant(plant)
118: 
119: func _cell(col: int, row: int) -> Cell:
120: 	return cells[row][col] if is_valid(col, row) else null
121: 
122: func _on_seed_selected(seed_id: StringName) -> void:
123: 	pending_seed = seed_id
124: 	_refresh_previews()
125: 
126: ## Fase 3: al destruirse una planta se libera su celda.
127: func _on_plant_destroyed(plant: Node) -> void:
128: 	if plant is Plant:
129: 		var cell: Cell = _cell(plant.col, plant.row)
130: 		if cell:
131: 			cell.clear_plant()
132: 
133: ## Pinta preview verde/rojo en TODAS las celdas según la semilla pendiente
134: ## (verde = se puede plantar, rojo = no se puede). Sin semilla, limpia.
135: func _refresh_previews() -> void:
136: 	for row in ROWS:
137: 		for col in COLS:
138: 			var cell: Cell = _cell(col, row)
139: 			if pending_seed == &"":
140: 				cell.set_preview(Cell.PREVIEW_NONE)
141: 			elif can_plant(pending_seed, col, row):
142: 				cell.set_preview(Cell.PREVIEW_OK)
143: 			else:
144: 				cell.set_preview(Cell.PREVIEW_BAD)
145: 
146: func _build_lawn_background() -> void:
147: 	var top_left := -BOARD_SIZE / 2.0
148: 
149: 	# Relleno principal.
150: 	var lawn := ColorRect.new()
151: 	lawn.size = BOARD_SIZE
152: 	lawn.position = top_left
153: 	lawn.color = COLOR_LAWN_A
154: 	lawn.mouse_filter = Control.MOUSE_FILTER_IGNORE
155: 	add_child(lawn)
156: 
157: 	# Filas alternas más claras (efecto césped rayado).
158: 	for row in ROWS:
159: 		if row % 2 == 0:
160: 			continue
161: 		var stripe := ColorRect.new()
162: 		stripe.size = Vector2(BOARD_SIZE.x, CELL_SIZE.y)
163: 		stripe.position = top_left + Vector2(0.0, row * CELL_SIZE.y)
164: 		stripe.color = COLOR_LAWN_B
165: 		stripe.mouse_filter = Control.MOUSE_FILTER_IGNORE
166: 		add_child(stripe)
167: 
168: 	# Marco/borde (se dibuja detrás del césped).
169: 	var edge := 4.0
170: 	var frame := ColorRect.new()
171: 	frame.size = BOARD_SIZE + Vector2(edge * 2.0, edge * 2.0)
172: 	frame.position = top_left - Vector2(edge, edge)
173: 	frame.color = COLOR_EDGE
174: 	frame.mouse_filter = Control.MOUSE_FILTER_IGNORE
175: 	add_child(frame)
176: 	frame.move_to_back()
177: 
178: func _build_cells() -> void:
179: 	for row in ROWS:
180: 		var row_arr: Array = []
181: 		for col in COLS:
182: 			var cell: Cell = CELL_SCENE.instantiate()
183: 			cell.setup(col, row)
184: 			cell.position = cell_center(col, row)
185: 			add_child(cell)
186: 			row_arr.append(cell)
187: 		cells.append(row_arr)
188: 
189: func _on_cell_clicked(col: int, row: int) -> void:
190: 	print("[Board] Celda clicada -> col=%d, fila=%d" % [col, row])
191: 
192: 	# Fase 3: si hay una semilla seleccionada, intenta plantarla.
193: 	if pending_seed != &"":
194: 		var planted: Plant = plant(pending_seed, col, row)
195: 		if planted != null:
196: 			print("[Board] Plantada '%s' en (%d,%d)" % [pending_seed, col, row])
197: 			# El Main (que escucha plant_planted) paga el sol y reinicia el
198: 			# cooldown de la ranura; aquí solo limpiamos el preview.
199: 			pending_seed = &""
200: 			_refresh_previews()
201: 		else:
202: 			print("[Board] No se pudo plantar '%s' en (%d,%d)" % [pending_seed, col, row])
========================================

=== scenes\board\cell.gd ===
  1: class_name Cell
  2: extends Area2D
  3: 
  4: ## Cell — Una celda de la grilla del Board (Fase 1+3).
  5: ##
  6: ## Detecta hover y clic, y emite por EventBus la coordenada (col, row).
  7: ## En la Fase 3 muestra el preview de siembra (verde = válida, rojo =
  8: ## inválida) y guarda la referencia a la planta que la ocupa.
  9: ##
 10: ## OJO: `setup()` solo guarda valores (se llama ANTES de add_child, cuando
 11: ## los @onready aún no existen). El pintado se aplica en _ready().
 12: 
 13: ## Modos de preview de siembra.
 14: enum Preview { NONE, OK, BAD }
 15: 
 16: @export var col: int = 0
 17: @export var row: int = 0
 18: 
 19: ## Planta que ocupa la celda (null = libre).
 20: var plant: Plant = null
 21: var _preview: Preview = Preview.NONE
 22: 
 23: @onready var _highlight: ColorRect = $Highlight
 24: @onready var _base: ColorRect = $Base
 25: 
 26: const COLOR_A := Color(0.42, 0.78, 0.36, 1.0)  # verde claro
 27: const COLOR_B := Color(0.36, 0.70, 0.32, 1.0)  # verde oscuro (alterno por fila)
 28: const COLOR_HOVER := Color(1.0, 1.0, 0.6, 0.35) # amarillo translúcido
 29: const COLOR_PREVIEW_OK := Color(0.35, 1.0, 0.45, 0.45)
 30: const COLOR_PREVIEW_BAD := Color(1.0, 0.3, 0.3, 0.45)
 31: 
 32: ## Captura los datos de la celda. NO tocar nodos aquí (aún no está en el árbol).
 33: func setup(p_col: int, p_row: int) -> void:
 34: 	col = p_col
 35: 	row = p_row
 36: 
 37: func _ready() -> void:
 38: 	_base.color = COLOR_A if row % 2 == 0 else COLOR_B
 39: 	input_event.connect(_on_input_event)
 40: 	mouse_entered.connect(_on_mouse_entered)
 41: 	mouse_exited.connect(_on_mouse_exited)
 42: 
 43: func _on_mouse_entered() -> void:
 44: 	# El hover no debe pisar un preview de siembra activo.
 45: 	if _preview == Preview.NONE:
 46: 		_highlight.color = COLOR_HOVER
 47: 
 48: func _on_mouse_exited() -> void:
 49: 	if _preview == Preview.NONE:
 50: 		_highlight.color = Color.TRANSPARENT
 51: 
 52: ## ── Ocupación (Fase 3) ────────────────────────────────────────────────────
 53: 
 54: func is_occupied() -> bool:
 55: 	return plant != null and is_instance_valid(plant)
 56: 
 57: func set_plant(p_plant: Plant) -> void:
 58: 	plant = p_plant
 59: 
 60: func clear_plant() -> void:
 61: 	plant = null
 62: 
 63: ## ── Preview de siembra (Fase 3) ───────────────────────────────────────────
 64: 
 65: func set_preview(mode: Preview) -> void:
 66: 	_preview = mode
 67: 	_update_preview_color()
 68: 
 69: func _update_preview_color() -> void:
 70: 	match _preview:
 71: 		Preview.OK:
 72: 			_highlight.color = COLOR_PREVIEW_OK
 73: 		Preview.BAD:
 74: 			_highlight.color = COLOR_PREVIEW_BAD
 75: 		_:
 76: 			_highlight.color = Color.TRANSPARENT
 77: 
 78: func _on_input_event(_viewport: Node, event: InputEvent, _shape_idx: int) -> void:
 79: 	if event is InputEventMouseButton and event.pressed and event.button_index == MOUSE_BUTTON_LEFT:
 80: 		EventBus.cell_clicked.emit(col, row)
========================================

=== scenes\main\main.gd ===
  1: extends Node2D
  2: 
  3: ## Main — Raíz de la partida.
  4: ##
  5: ## Fase 2: Board (grilla 9x5) + lluvia de sol (SunLayer) + HUD con contador.
  6: ## Fase 3: orquesta la siembra — al recibir `plant_planted` del Board paga
  7: ## el sol y arranca el cooldown de la ranura correspondiente.
  8: ## Fase 4/5: hotkeys de debug para probar combate:
  9: ##   - Z: spawnea un zombie de prueba en la fila 0
 10: ##   - G: spawnea un zombie por cada fila (0..4)
 11: ##   - T: te da 1000☀ (probar plantas caras rápido)
 12: 
 13: const ZOMBIE_SCENE := preload("res://scenes/zombies/zombie.tscn")
 14: 
 15: @onready var board: Node2D = $Board
 16: @onready var entities: Node2D = $Entities
 17: @onready var fps_label: Label = %FpsLabel
 18: @onready var seed_bar: HBoxContainer = $UI/HUD/SeedBar
 19: 
 20: func _ready() -> void:
 21: 	EventBus.plant_planted.connect(_on_plant_planted)
 22: 	EventBus.zombie_reached_house.connect(_on_zombie_reached_house)
 23: 	seed_bar.clear_selection()
 24: 
 25: func _process(_delta: float) -> void:
 26: 	fps_label.text = "FPS: %d" % Engine.get_frames_per_second()
 27: 
 28: func _unhandled_input(event: InputEvent) -> void:
 29: 	if event is InputEventKey and event.pressed and not event.echo:
 30: 		match event.keycode:
 31: 			KEY_Z:
 32: 				_spawn_test_zombie(0)
 33: 			KEY_G:
 34: 				for r in 5:
 35: 					_spawn_test_zombie(r)
 36: 			KEY_T:
 37: 				SunBank.add(1000)
 38: 				print("[Main] +1000☀ (total: %d)" % SunBank.amount)
 39: 
 40: ## Debug: spawnea un zombie en la fila `row` entrando por la derecha.
 41: func _spawn_test_zombie(row: int) -> void:
 42: 	var zombie: Zombie = ZOMBIE_SCENE.instantiate()
 43: 	zombie.setup(row)
 44: 	zombie.global_position = Vector2(board.world_center(8, row).x + 40.0, board.world_center(0, row).y)
 45: 	entities.add_child(zombie)
 46: 	print("[Main] Zombie de prueba spawneado en fila %d" % row)
 47: 
 48: ## Fase 3: al plantarse una planta (lo hace el Board), pagamos el sol y
 49: ## ponemos la ranura en cooldown.
 50: func _on_plant_planted(plant: Node2D, _col: int, _row: int) -> void:
 51: 	if plant == null or not (plant is Plant):
 52: 		return
 53: 	var p: Plant = plant as Plant
 54: 	if p.data == null:
 55: 		return
 56: 	SunBank.spend(p.data.cost)
 57: 	print("[Main] Plantada %s — coste %d☀ (restante: %d☀)" % [p.data.display_name, p.data.cost, SunBank.amount])
 58: 	# Reinicia la selección de la barra (si el jugador quiere re-sembrar,
 59: 	# vuelve a pulsar la ranura cuando el cooldown termine).
 60: 	seed_bar.clear_selection()
 61: 	seed_bar.start_cooldown(p.data.id)
 62: 
 63: ## Fase 5: un zombie llegó a la casa → derrota (placeholder: log + pausa).
 64: func _on_zombie_reached_house(_zombie: Node2D) -> void:
 65: 	print("[Main] 💀 ¡DERROTA! Un zombie llegó a la casa")
 66: 	EventBus.game_lost.emit()
 67: 	GameManager.change_state(GameManager.State.LOST)
