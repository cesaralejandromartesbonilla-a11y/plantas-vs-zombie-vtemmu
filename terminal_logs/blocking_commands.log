  1: class_name Zombie
  2: extends CharacterBody2D
  3: 
  4: ## Zombie — 🧟 Zombie básico (Fase 5).
  5: ##
  6: ## Camina por su carril de derecha a izquierda. Si encuentra una planta en
  7: ## su celda la muerde (100 daño / 0.5 s) hasta destruirla y luego sigue.
  8: ## Si llega al borde izquierdo (la casa), emite zombie_reached_house.
  9: ##
 10: ## Números configurados por export (balance inicial, sección 5 de la hoja).
 11: 
 12: const WALK_SPEED := 7.0           # píxeles/segundo (lento, "shambling")
 13: const HOUSE_X := 68.0             # borde izquierdo = la casa
 14: const BITE_DAMAGE := 100
 15: const BITE_INTERVAL := 0.5        # segundos entre mordidas
 16: const BITE_RANGE := 50.0          # píxeles a la izquierda donde muerde
 17: 
 18: var hp: int = 200
 19: var row: int = 0
 20: 
 21: var _eating: bool = false
 22: var _bite_timer: float = 0.0
 23: var _target: Plant = null
 24: var _reached_house: bool = false
 25: 
 26: func _ready() -> void:
 27: 	EventBus.zombie_spawned.emit(self, row)
 28: 
 29: ## Registra la fila en la que camina (la pone Main al instanciarlo).
 30: func setup(p_row: int) -> void:
 31: 	row = p_row
 32: 
 33: func take_damage(amount: int) -> void:
 34: 	if hp <= 0:
 35: 		return
 36: 	hp = maxi(0, hp - amount)
 37: 	EventBus.zombie_damaged.emit(self, amount)
 38: 	if hp == 0:
 39: 		_die()
 40: 
 41: func _die() -> void:
 42: 	EventBus.zombie_died.emit(self)
 43: 	queue_free()
 44: 
 45: func _physics_process(delta: float) -> void:
 46: 	if _reached_house or hp <= 0:
 47: 		return
 48: 
 49: 	# Busca comida solo si no está comiendo.
 50: 	if not _eating:
 51: 		_target = _find_plant_ahead()
 52: 		if _target != null:
 53: 			_eating = true
 54: 			_bite_timer = BITE_INTERVAL
 55: 
 56: 	if _eating:
 57: 		# La planta puede haber muerto mientras comía.
 58: 		if _target == null or not is_instance_valid(_target) or _target.hp <= 0:
 59: 			_eating = false
 60: 			_target = null
 61: 		else:
 62: 			_position_beside_plant()
 63: 			_bite_timer -= delta
 64: 			if _bite_timer <= 0.0:
 65: 				_bite_timer = BITE_INTERVAL
 66: 				_target.take_damage(BITE_DAMAGE)
 67: 	else:
 68: 		# Camina hacia la casa.
 69: 		global_position.x -= WALK_SPEED
 70: 		if global_position.x <= HOUSE_X:
 71: 			_reached_house = true
 72: 			EventBus.zombie_reached_house.emit(self)
 73: 			queue_free()
 74: 
 75: ## El zombie se pega a la planta que está comiendo (evita solaparse).
 76: func _position_beside_plant() -> void:
 77: 	var offset := 30.0
 78: 	var desired := _target.global_position.x + offset
 79: 	if global_position.x > desired:
 80: 		global_position.x = move_toward(global_position.x, desired, WALK_SPEED * 2.5)
 81: 
 82: ## Planta más cercana a la izquierda en este carril (dentro del alcance).
 83: func _find_plant_ahead() -> Plant:
 84: 	for plant in get_tree().get_nodes_in_group("plants"):
 85: 		if not is_instance_valid(plant):
 86: 			continue
 87: 		if not plant is Plant:
 88: 			continue
 89: 		if plant.row != row:
 90: 			continue
 91: 		var px := plant.global_position.x
 92: 		if px >= global_position.x:  # la planta debe estar enfrente (izq.)
 93: 			continue
 94: 		if global_position.x - px > BITE_RANGE:
 95: 			continue
 96: 		return plant as Plant
 97: 	return null
 98: 
 99: ## Placeholder visual: zombie gris/verde mirando a la izquierda.
100: func _draw() -> void:
101: 	var skin := Color(0.35, 0.5, 0.3)
102: 	var dark := Color(0.22, 0.32, 0.2)
103: 
104: 	# Cabeza.
105: 	draw_circle(Vector2(0, -10), 14.0, skin)
106: 
107: 	# Cuerpo.
108: 	draw_rect(Rect2(-10, -2, 20, 30), skin)
109: 
110: 	# Brazo estirado hacia la izquierda (zombie hambriento).
111: 	draw_rect(Rect2(-26, 2, 18, 7), skin)
112: 
113: 	# Ojos (mirando a la izquierda).
114: 	draw_circle(Vector2(-5, -13), 3.2, Color(1, 0.7, 0.3))
115: 	draw_circle(Vector2(4, -13), 3.2, Color(1, 0.7, 0.3))
116: 	draw_circle(Vector2(-5, -13), 1.5, Color.BLACK)
117: 	draw_circle(Vector2(4, -13), 1.5, Color.BLACK)
118: 
119: 	# Sombrero pequeño de zombie.
120: 	draw_rect(Rect2(-8, -26, 16, 5), dark)
