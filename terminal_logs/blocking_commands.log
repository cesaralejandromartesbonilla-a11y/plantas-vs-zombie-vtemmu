=== scenes/board/cell.gd ===
  1: class_name Cell
  2: extends Area2D
  3: 
  4: ## Cell — Una celda de la grilla del Board (Fase 1+3).
  5: ##
  6: ## Detecta hover y clic, y emite por EventBus la coordenada (col, row).
  7: ## En la Fase 3 muestra el preview de siembra (verde = válida, rojo =
  8: ## inválida) y guarda la referencia a la planta que la ocupa.
  9: ##
 10: ## OJO: `setup()` solo guarda valores (se llama ANTES de add_child, cuando
 11: ## los @onready aún no existen). El pintado se aplica en _ready().
 12: 
 13: ## Modos de preview de siembra.
 14: enum Preview { NONE, OK, BAD }
 15: 
 16: @export var col: int = 0
 17: @export var row: int = 0
 18: 
 19: ## Planta que ocupa la celda (null = libre).
 20: var plant: Plant = null
 21: var _preview: Preview = Preview.NONE
 22: 
 23: @onready var _highlight: ColorRect = $Highlight
 24: @onready var _base: ColorRect = $Base
 25: 
 26: const COLOR_A := Color(0.42, 0.78, 0.36, 1.0)  # verde claro
 27: const COLOR_B := Color(0.36, 0.70, 0.32, 1.0)  # verde oscuro (alterno por fila)
 28: const COLOR_HOVER := Color(1.0, 1.0, 0.6, 0.35) # amarillo translúcido
 29: const COLOR_PREVIEW_OK := Color(0.35, 1.0, 0.45, 0.45)
 30: const COLOR_PREVIEW_BAD := Color(1.0, 0.3, 0.3, 0.45)
 31: 
 32: ## Captura los datos de la celda. NO tocar nodos aquí (aún no está en el árbol).
 33: func setup(p_col: int, p_row: int) -> void:
 34: 	col = p_col
 35: 	row = p_row
 36: 
 37: func _ready() -> void:
 38: 	_base.color = COLOR_A if row % 2 == 0 else COLOR_B
 39: 	input_event.connect(_on_input_event)
 40: 	mouse_entered.connect(_on_mouse_entered)
 41: 	mouse_exited.connect(_on_mouse_exited)
 42: 
 43: func _on_mouse_entered() -> void:
 44: 	# El hover no debe pisar un preview de siembra activo.
 45: 	if _preview == Preview.NONE:
 46: 		_highlight.color = COLOR_HOVER
 47: 
 48: func _on_mouse_exited() -> void:
 49: 	if _preview == Preview.NONE:
 50: 		_highlight.color = Color.TRANSPARENT
 51: 
 52: ## ── Ocupación (Fase 3) ────────────────────────────────────────────────────
 53: 
 54: func is_occupied() -> bool:
 55: 	return plant != null and is_instance_valid(plant)
 56: 
 57: func set_plant(p_plant: Plant) -> void:
 58: 	plant = p_plant
 59: 
 60: func clear_plant() -> void:
 61: 	plant = null
 62: 
 63: ## ── Preview de siembra (Fase 3) ───────────────────────────────────────────
 64: 
 65: func set_preview(mode: Preview) -> void:
 66: 	_preview = mode
 67: 	_update_preview_color()
 68: 
 69: func _update_preview_color() -> void:
 70: 	match _preview:
 71: 		Preview.OK:
 72: 			_highlight.color = COLOR_PREVIEW_OK
 73: 		Preview.BAD:
 74: 			_highlight.color = COLOR_PREVIEW_BAD
 75: 		_:
 76: 			_highlight.color = Color.TRANSPARENT
 77: 
 78: func _on_input_event(_viewport: Node, event: InputEvent, _shape_idx: int) -> void:
 79: 	if event is InputEventMouseButton and event.pressed and event.button_index == MOUSE_BUTTON_LEFT:
 80: 		EventBus.cell_clicked.emit(col, row)
