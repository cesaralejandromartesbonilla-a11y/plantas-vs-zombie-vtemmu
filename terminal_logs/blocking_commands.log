=== scenes\sun\sun_spawner.gd ===
  1: extends Node2D
  2: 
  3: ## SunSpawner — Lluvia de sol del cielo (Fase 2).
  4: ##
  5: ## Este script va en el nodo `SunLayer` (grupo "sun_layer") dentro de Main.
  6: ## Suelta un sol cada 7-13 s en una posición X aleatoria sobre el tablero;
  7: ## el sol cae 3 s hasta una profundidad aleatoria y queda recogible.
  8: 
  9: const SUN_SCENE := preload("res://scenes/sun/sun.tscn")
 10: 
 11: ## Rango horizontal de caída (sobre el césped del board, 280..1000).
 12: const SPAWN_X_MIN := 300.0
 13: const SPAWN_X_MAX := 980.0
 14: ## Rango de profundidad a la que aterriza.
 15: const LAND_Y_MIN := 150.0
 16: const LAND_Y_MAX := 590.0
 17: 
 18: @onready var _timer: Timer = $SpawnTimer
 19: 
 20: func _ready() -> void:
 21: 	_timer.timeout.connect(_spawn_sky_sun)
 22: 	_timer.wait_time = randf_range(2.0, 4.0)  # primer sol pronto
 23: 	_timer.start()
 24: 
 25: func _spawn_sky_sun() -> void:
 26: 	var sun: Node2D = SUN_SCENE.instantiate()
 27: 	var spawn_x := randf_range(SPAWN_X_MIN, SPAWN_X_MAX)
 28: 	var start := Vector2(spawn_x, -40.0)
 29: 	var target := Vector2(spawn_x, randf_range(LAND_Y_MIN, LAND_Y_MAX))
 30: 	sun.global_position = start
 31: 	add_child(sun)
 32: 	sun.fall_from(start, target, 3.0)
 33: 	EventBus.sun_dropped.emit(sun)
 34: 
 35: 	# Siguiente sol en 7-13 s.
 36: 	_timer.wait_time = randf_range(7.0, 13.0)
