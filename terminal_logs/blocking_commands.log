=== scenes\plants\plant.gd ===
  1: class_name Plant
  2: extends Node2D
  3: 
  4: ## Plant — Clase base de todas las plantas (Fase 2+).
  5: ##
  6: ## Cada variedad hereda y sobrescribe:_draw() para su placeholder visual y
  7: ## su comportamiento (disparar, producir sol, tanquear). Extensible por
  8: ## herencia: Fase 4 (lanzaguisantes) y Fase 5 (nuez) solo añaden lógica.
  9: 
 10: @export var data: PlantData
 11: 
 12: var hp: int = 0
 13: var col: int = -1
 14: var row: int = -1
 15: 
 16: ## Registra la posición de grilla y aplica el HP del resource.
 17: ## (Usar tras instantiate; `data` ya viene asignado desde el .tscn.)
 18: func setup(p_col: int, p_row: int) -> void:
 19: 	col = p_col
 20: 	row = p_row
 21: 	hp = data.max_hp if data else 0
 22: 
 23: func take_damage(amount: int) -> void:
 24: 	if hp <= 0:
 25: 		return
 26: 	hp = maxi(0, hp - amount)
 27: 	EventBus.plant_damaged.emit(self, amount)
 28: 	if hp == 0:
 29: 		_die()
 30: 
 31: func _die() -> void:
 32: 	EventBus.plant_destroyed.emit(self)
 33: 	queue_free()
 34: 
 35: ## Placeholder visual genérico (círculo verde). Cada planta lo sobrescribe.
 36: func _draw() -> void:
 37: 	draw_circle(Vector2.ZERO, 22.0, Color(0.2, 0.8, 0.3))
