=== ui/seed_bar.gd ===
  1: extends HBoxContainer
  2: 
  3: ## SeedBar — Barra de semillas del HUD (Fase 3).
  4: ##
  5: ## Crea una ranura (SeedSlot) por semilla registrada en PlantLibrary y
  6: ## gestiona la selección: solo una activa a la vez, con deselección al
  7: ## volver a pulsar la misma ranura o al pulsar clic derecho.
  8: ##
  9: ## Flujo de siembra: la selección se publica por EventBus.seed_selected;
 10: ## el Main escucha y planta al hacer clic en una celda válida. Los slots
 11: ## se refrescan al cambiar el sol (para el estado "sin sol").
 12: 
 13: signal seed_deselected
 14: 
 15: ## Orden de presentación de las semillas en la barra.
 16: const SEED_ORDER: Array[StringName] = [&"sunflower", &"peashooter", &"wallnut"]
 17: 
 18: ## seed_id -> SeedSlot
 19: var slots: Dictionary = {}
 20: 
 21: var _current_seed: StringName = &""
 22: var _prev_sun: int = -9999
 23: 
 24: func _ready() -> void:
 25: 	_build_slots()
 26: 	EventBus.sun_changed.connect(_on_sun_changed)
 27: 	EventBus.cell_clicked.connect(_on_cell_clicked)
 28: 
 29: func _build_slots() -> void:
 30: 	var slot_scene := preload("res://ui/seed_slot.tscn")
 31: 	for seed_id: StringName in SEED_ORDER:
 32: 		if not PlantLibrary.has_seed(seed_id):
 33: 			continue
 34: 		var slot: SeedSlot = slot_scene.instantiate()
 35: 		slot.setup(seed_id)
 36: 		slot.slot_pressed.connect(_on_slot_pressed)
 37: 		add_child(slot)
 38: 		slots[seed_id] = slot
 39: 
 40: ## Semilla actualmente seleccionada, o &"" si ninguna.
 41: func current_seed() -> StringName:
 42: 	return _current_seed
 43: 
 44: ## Intenta seleccionar/deseleccionar una semilla.
 45: func select_seed(seed_id: StringName) -> void:
 46: 	if _current_seed == seed_id:
 47: 		_clear_selection()
 48: 		return
 49: 	_select(seed_id)
 50: 
 51: func _on_slot_pressed(seed_id: StringName) -> void:
 52: 	select_seed(seed_id)
 53: 
 54: ## Tras sembrar, se vacía la selección (una planta por clic).
 55: func clear_selection() -> void:
 56: 	_clear_selection()
 57: 
 58: ## Pone en cooldown la ranura `seed_id` (lo llama Main al plantar).
 59: func start_cooldown(seed_id: StringName) -> void:
 60: 	var slot: SeedSlot = slots.get(seed_id)
 61: 	if slot:
 62: 		slot.start_cooldown()
 63: 	_refresh_slots()
 64: 
 65: func _select(seed_id: StringName) -> void:
 66: 	for key: StringName in slots:
 67: 		var slot: SeedSlot = slots[key]
 68: 		slot.set_selected(key == seed_id)
 69: 	_current_seed = seed_id
 70: 	EventBus.seed_selected.emit(seed_id)
 71: 
 72: func _clear_selection() -> void:
 73: 	_current_seed = &""
 74: 	for key: StringName in slots:
 75: 		slots[key].set_selected(false)
 76: 	seed_deselected.emit()
 77: 	# El Board se entera de que ya no hay semilla pendiente (limpia previews).
 78: 	EventBus.seed_selected.emit(&"")
 79: 
 80: ## Si había una semilla y se clica una celda, la siembra la gestiona Main
 81: ## (que escucha cell_clicked). Aquí solo refrescamos estados.
 82: func _on_cell_clicked(_col: int, _row: int) -> void:
 83: 	_refresh_slots()
 84: 
 85: ## Actualiza el estado "sin sol" de cada ranura.
 86: func _on_sun_changed(total: int) -> void:
 87: 	# Evitar redibujar en cada cambio si el total no varía.
 88: 	if total == _prev_sun:
 89: 		return
 90: 	_prev_sun = total
 91: 	_refresh_slots()
 92: 
 93: func _refresh_slots() -> void:
 94: 	for key: StringName in slots:
 95: 		slots[key].refresh()
 96: 
 97: func _unhandled_input(event: InputEvent) -> void:
 98: 	# Clic derecho cancela la selección.
 99: 	if event is InputEventMouseButton and event.pressed and event.button_index == MOUSE_BUTTON_RIGHT:
100: 		if _current_seed != &"":
101: 			_clear_selection()
102: 			get_viewport().set_input_as_handled()
