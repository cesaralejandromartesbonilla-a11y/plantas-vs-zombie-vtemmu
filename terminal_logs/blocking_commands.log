=== ui/seed_slot.gd ===
  1: extends Button
  2: 
  3: ## SeedSlot — Ranura de semilla de la SeedBar (Fase 3).
  4: ##
  5: ## Muestra el nombre y el costo de la semilla, y durante el cooldown dibuja
  6: ## una cortina gris que se vacía junto con los segundos restantes.
  7: ## El templado de la ranura lo hace la SeedBar vía `setup()`.
  8: ##
  9: ## Estados visuales:
 10: ##   - Normal: fondo verde botánico + texto claro.
 11: ##   - Sin sol: fondo gris verdoso + costo en rojo (no clicable).
 12: ##   - Cooldown: cortina gris que baja + icono de recarga + tiempo restante.
 13: ##   - Seleccionada: fondo amarillo (la SeedBar la marca con set_selected()).
 14: 
 15: signal slot_pressed(seed_id: StringName)
 16: 
 17: const COLOR_BG := Color(0.22, 0.42, 0.2, 0.95)
 18: const COLOR_BG_LOW_SUN := Color(0.3, 0.34, 0.28, 0.95)
 19: const COLOR_BG_SELECTED := Color(0.85, 0.8, 0.35, 1.0)
 20: const COLOR_BORDER := Color(0.12, 0.25, 0.11, 1.0)
 21: const COLOR_TEXT := Color(1, 1, 1, 1)
 22: const COLOR_COST_OK := Color(1, 0.95, 0.6, 1)
 23: const COLOR_COST_LOW := Color(1, 0.45, 0.35, 1)
 24: const COLOR_COOLDOWN := Color(0.06, 0.1, 0.06, 0.8)
 25: 
 26: const FONT_SIZE_NAME := 14
 27: const FONT_SIZE_COST := 13
 28: 
 29: var seed_id: StringName = &""
 30: var data: PlantData
 31: var is_selected: bool = false
 32: 
 33: var _cooldown_left: float = 0.0
 34: 
 35: func setup(p_seed_id: StringName) -> void:
 36: 	seed_id = p_seed_id
 37: 	data = PlantLibrary.get_data(seed_id)
 38: 	if data:
 39: 		tooltip_text = "%s — %d☀ · recarga %.1fs" % [data.display_name, data.cost, data.cooldown]
 40: 
 41: func _ready() -> void:
 42: 	custom_minimum_size = Vector2(132, 84)
 43: 	mouse_default_cursor_shape = Control.CURSOR_POINTING_HAND
 44: 	pressed.connect(_on_pressed)
 45: 	_refresh_visual()
 46: 
 47: ## Inicia el cooldown de esta ranura.
 48: func start_cooldown() -> void:
 49: 	_cooldown_left = data.cooldown if data else 0.0
 50: 	_refresh_visual()
 51: 
 52: func _process(delta: float) -> void:
 53: 	if _cooldown_left > 0.0:
 54: 		var prev := _cooldown_left
 55: 		_cooldown_left = maxf(0.0, _cooldown_left - delta)
 56: 		if int(prev * 10.0) != int(_cooldown_left * 10.0) or _cooldown_left <= 0.0:
 57: 			queue_redraw()
 58: 		# Al terminar el cooldown se rehabilita (puede que ya haya sol).
 59: 		if _cooldown_left <= 0.0:
 60: 			_refresh_visual()
 61: 
 62: func is_on_cooldown() -> bool:
 63: 	return _cooldown_left > 0.0
 64: 
 65: func can_afford() -> bool:
 66: 	return data != null and SunBank.can_afford(data.cost)
 67: 
 68: ## La SeedBar marca/desmarca la selección activa.
 69: func set_selected(selected: bool) -> void:
 70: 	is_selected = selected
 71: 	queue_redraw()
 72: 
 73: func _on_pressed() -> void:
 74: 	if is_on_cooldown():
 75: 		return
 76: 	slot_pressed.emit(seed_id)
 77: 
 78: ## Recalcula el estado habilitado/deshabilitado (la SeedBar lo llama
 79: ## cuando cambia el sol o tras sembrar).
 80: func refresh() -> void:
 81: 	_refresh_visual()
 82: 
 83: ## Botón habilitado solo cuando la semilla está lista y hay sol.
 84: func _refresh_visual() -> void:
 85: 	var ready: bool = not is_on_cooldown() and can_afford()
 86: 	if disabled != not ready:
 87: 		disabled = not ready
 88: 	queue_redraw()
 89: 
 90: func _notification(what: int) -> void:
 91: 	if what == NOTIFICATION_THEME_CHANGED:
 92: 		_refresh_visual()
 93: 
 94: func _draw() -> void:
 95: 	var rect := Rect2(Vector2.ZERO, size)
 96: 
 97: 	# Fondo según estado.
 98: 	var bg := COLOR_BG
 99: 	if is_selected:
100: 		bg = COLOR_BG_SELECTED
101: 	elif is_on_cooldown():
102: 		bg = COLOR_BG.darkened(0.3)
103: 	elif not can_afford():
104: 		bg = COLOR_BG_LOW_SUN
105: 
106: 	var box := StyleBoxFlat.new()
107: 	box.bg_color = bg
108: 	box.corner_radius_top_left = 8
109: 	box.corner_radius_top_right = 8
110: 	box.corner_radius_bottom_right = 8
111: 	box.corner_radius_bottom_left = 8
112: 	draw_style_box(box, rect)
113: 	draw_rect(rect.grow(-1.0), COLOR_BORDER, false, 2.0)
114: 
115: 	if data == null:
116: 		draw_string(ThemeDB.fallback_font, Vector2(8, 32), "—", HORIZONTAL_ALIGNMENT_LEFT, -1, FONT_SIZE_NAME, COLOR_TEXT)
117: 		return
118: 
119: 	# Texto: nombre arriba, costo abajo.
120: 	draw_string(ThemeDB.fallback_font, Vector2(8, 22), data.display_name, HORIZONTAL_ALIGNMENT_LEFT, -1, FONT_SIZE_NAME, COLOR_TEXT)
121: 	var cost_color := COLOR_COST_OK if can_afford() else COLOR_COST_LOW
122: 	draw_string(ThemeDB.fallback_font, Vector2(8, 42), "%d☀" % data.cost, HORIZONTAL_ALIGNMENT_LEFT, -1, FONT_SIZE_COST, cost_color)
123: 
124: 	# Cooldown: cortina gris + icono de recarga + segundos restantes.
125: 	if is_on_cooldown() and data:
126: 		var fraction := clampf(_cooldown_left / data.cooldown, 0.0, 1.0)
127: 		var cover := Rect2(0.0, size.y * (1.0 - fraction), size.x, size.y * fraction)
128: 		draw_rect(cover, COLOR_COOLDOWN)
129: 
130: 		var cx := size.x * 0.5
131: 		var cy := size.y * 0.58
132: 		var r := 15.0
133: 		# Flecha circular de recarga (arco + punta de flecha).
134: 		draw_arc(Vector2(cx, cy), r, -0.4, 4.6, 16, Color(1, 1, 1, 0.95), 2.2)
135: 		var angle := 4.6
136: 		var tip := Vector2(cx, cy) + Vector2.from_angle(angle - 0.65) * r
137: 		var perp := Vector2.from_angle(angle + TAU / 4.0)
138: 		draw_triangle(tip, tip - perp * 4.5, tip + perp * 4.5, Color(1, 1, 1, 0.95))
139: 
140: 		draw_string(ThemeDB.fallback_font, Vector2(4, size.y - 6.0), "%.1f s" % _cooldown_left,
141: 				HORIZONTAL_ALIGNMENT_CENTER, size.x - 8.0, 12, Color(1, 1, 1, 0.95))
142: 
143: func draw_triangle(a: Vector2, b: Vector2, c: Vector2, color: Color) -> void:
144: 	var pts := PackedVector2Array([a, b, c])
145: 	draw_colored_polygon(pts, color)
