  3: ## GameManager — Máquina de estados de la partida.
  4: ##
  5: ## Estados: MENU -> PLAYING -> (WON | LOST)  y  PAUSED (en cualquier momento).
  6: ## Es un autoload: accesible desde cualquier nodo como `GameManager`.
  7: 
  8: enum State { MENU, PLAYING, WON, LOST, PAUSED }
  9: 
 10: signal state_changed(new_state: State)
 11: 
 12: var state: State = State.MENU:
 13: 	set(value):
 14: 		if state == value:
 15: 			return
 16: 		state = value
 17: 		state_changed.emit(state)
 18: 
 19: func _ready() -> void:
 20: 	process_mode = Node.PROCESS_MODE_ALWAYS
 21: 	state_changed.connect(_on_state_changed)
 22: 
 23: ## Cambia de estado validando transiciones permitidas.
 24: func change_state(new_state: State) -> bool:
 25: 	match state:
 26: 		State.MENU:
 27: 			if new_state != State.PLAYING:
 28: 				return false
 29: 		State.PLAYING:
 30: 			if new_state not in [State.PAUSED, State.WON, State.LOST]:
 31: 				return false
 32: 		State.PAUSED:
 33: 			if new_state not in [State.PLAYING, State.WON, State.LOST]:
 34: 				return false
 35: 		State.WON, State.LOST:
 36: 			# Desde fin de partida solo se reinicia toda la escena.
 37: 			return false
 38: 	state = new_state
 39: 	return true
 40: 
 41: func _toggle_pause() -> void:
 42: 	if state == State.PLAYING:
 43: 		change_state(State.PAUSED)
 44: 	elif state == State.PAUSED:
 45: 		change_state(State.PLAYING)
 46: 
 47: func _on_state_changed(new_state: State) -> void:
 48: 	match new_state:
 49: 		State.PLAYING:
 50: 			get_tree().paused = false
 51: 		State.PAUSED:
 52: 			get_tree().paused = true
 53: 		State.WON, State.LOST:
 54: 			get_tree().paused = true
 55: 		_:
 56: 			pass
 57: 
 58: func _unhandled_input(event: InputEvent) -> void:
 59: 	# Con los botones del ratón nos ponemos en pausa sin clicar plantas.
 60: 	if event.is_action_pressed("pause"):
 61: 		_toggle_pause()
========================================

=== autoload\plant_library.gd ===
  1: extends Node
  2: 
  3: ## PlantLibrary — Registro central de semillas disponibles (Fase 3).
  4: ##
  5: ## Autoload que mapea cada `seed_id` (StringName) a su PlantData (.tres).
  6: ## Lo consume la SeedBar para construir las ranuras y la lógica de siembra
  7: ## para instanciar la escena correcta al plantar.
  8: ##
  9: ## Para añadir una planta al MVP basta con:
 10: ##   1. Crear su .tres en data/plant_data/  (mismo id que el .tres).
 11: ##   2. Crear su escena en scenes/plants/   (con PlantData asignado).
 12: ##   3. Registrarla aquí en `_register_plants()`.
 13: 
 14: signal library_ready
 15: 
 16: const PREFAB_BY_ID := {
 17: 	&"sunflower": "res://scenes/plants/sunflower.tscn",
 18: 	&"peashooter": "res://scenes/plants/peashooter.tscn",
 19: 	&"wallnut": "res://scenes/plants/wallnut.tscn",
 20: }
 21: 
 22: ## seed_id -> PlantData
 23: var data_by_id: Dictionary = {}
 24: 
 25: func _ready() -> void:
 26: 	_register_plants()
 27: 	library_ready.emit()
 28: 
 29: ## Devuelve el PlantData de una semilla, o null si no existe.
 30: func get_data(seed_id: StringName) -> PlantData:
 31: 	return data_by_id.get(seed_id) as PlantData
 32: 
 33: ## ¿Existe una semilla registrada con este id?
 34: func has_seed(seed_id: StringName) -> bool:
 35: 	return data_by_id.has(seed_id)
 36: 
 37: ## Escena listada para una semilla (PackedScene listo para instanciar).
 38: func get_scene(seed_id: StringName) -> PackedScene:
 39: 	if not PREFAB_BY_ID.has(seed_id):
 40: 		push_error("PlantLibrary: no hay escena para la semilla '%s'" % seed_id)
 41: 		return null
 42: 	return load(PREFAB_BY_ID[seed_id])
 43: 
 44: func _register_plants() -> void:
 45: 	for seed_id: StringName in PREFAB_BY_ID:
 46: 		var path := "res://data/plant_data/%s.tres" % seed_id
 47: 		if not ResourceLoader.exists(path):
 48: 			push_error("PlantLibrary: falta el recurso %s" % path)
 49: 			continue
 50: 		var res: PlantData = load(path)
 51: 		if res == null or res.id != seed_id:
 52: 			push_error("PlantLibrary: %s no tiene PlantData válido (id=%s)" % [path, res.id if res else "<null>"])
 53: 			continue
 54: 		data_by_id[seed_id] = res
