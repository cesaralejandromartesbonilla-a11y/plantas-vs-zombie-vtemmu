=== scenes\sun\sun.gd ===
  1: class_name Sun
  2: extends Area2D
  3: 
  4: ## Sun — ☀️ Sol del juego (Fase 2).
  5: ##
  6: ## Estados: FALLING (cae del cielo) -> GROUND (en el suelo, recogible) ->
  7: ## COLLECTED (vuela al contador del HUD y suma a SunBank).
  8: ## El girasol también lo usa: `pop_at()` lo hace aparecer ya en el suelo.
  9: 
 10: enum State { FALLING, GROUND, COLLECTED }
 11: 
 12: const VALUE := 25
 13: const GROUND_LIFETIME := 8.0
 14: 
 15: const COLOR_CORE := Color(1.0, 0.95, 0.55)
 16: const COLOR_BODY := Color(1.0, 0.88, 0.2)
 17: const COLOR_RAY := Color(1.0, 0.8, 0.15)
 18: 
 19: var state: State = State.FALLING
 20: var value: int = VALUE
 21: 
 22: func _ready() -> void:
 23: 	input_event.connect(_on_input_event)
 24: 
 25: ## Cae desde `start_pos` hasta `target_pos` (lluvia del cielo).
 26: func fall_from(start_pos: Vector2, target_pos: Vector2, fall_time: float = 3.0) -> void:
 27: 	state = State.FALLING
 28: 	global_position = start_pos
 29: 	modulate.a = 1.0
 30: 	scale = Vector2.ONE
 31: 	var tween := create_tween()
 32: 	tween.tween_property(self, "global_position", target_pos, fall_time) \
 33: 		.set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
 34: 	tween.tween_callback(_land)
 35: 
 36: ## Aparece ya en el suelo con un pequeño rebote (sol del girasol).
 37: func pop_at(pos: Vector2) -> void:
 38: 	state = State.GROUND
 39: 	global_position = pos
 40: 	modulate.a = 1.0
 41: 	scale = Vector2.ZERO
 42: 	var tween := create_tween()
 43: 	tween.tween_property(self, "scale", Vector2.ONE, 0.3) \
 44: 		.set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
 45: 	_start_ground_lifetime()
 46: 
 47: func _land() -> void:
 48: 	if state != State.FALLING:
 49: 		return
 50: 	state = State.GROUND
 51: 	_start_ground_lifetime()
 52: 
 53: ## Si nadie lo recoge, se desvanece y desaparece.
 54: func _start_ground_lifetime() -> void:
 55: 	await get_tree().create_timer(GROUND_LIFETIME).timeout
 56: 	if not is_instance_valid(self) or state != State.GROUND:
 57: 		return
 58: 	var tween := create_tween()
 59: 	tween.tween_property(self, "modulate:a", 0.0, 0.5)
 60: 	tween.tween_callback(queue_free)
 61: 
 62: func _on_input_event(_viewport: Node, event: InputEvent, _shape_idx: int) -> void:
 63: 	if state != State.GROUND:
 64: 		return
 65: 	if event is InputEventMouseButton and event.pressed and event.button_index == MOUSE_BUTTON_LEFT:
 66: 		_collect()
 67: 
 68: func _collect() -> void:
 69: 	if state == State.COLLECTED:
 70: 		return
 71: 	state = State.COLLECTED
 72: 	# Cancela cualquier tween en curso (p. ej. el desvanecimiento final).
 73: 	for tween in get_tweens():
 74: 		tween.kill()
 75: 
 76: 	# Vuela hacia el ancla del contador de sol del HUD.
 77: 	var target := Vector2(118, 40)  # fallback si no hay ancla
 78: 	var anchor := get_tree().get_first_node_in_group("sun_anchor")
 79: 	if anchor:
 80: 		target = anchor.get_global_transform_with_canvas().origin
 81: 
 82: 	var tween := create_tween()
 83: 	tween.set_parallel(true)
 84: 	tween.tween_property(self, "global_position", target, 0.3) \
 85: 		.set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)
 86: 	tween.tween_property(self, "scale", Vector2(0.35, 0.35), 0.3)
 87: 	await tween.finished
 88: 	SunBank.add(value)
 89: 	queue_free()
 90: 
 91: ## Placeholder visual: núcleo + cuerpo + 8 rayos.
 92: func _draw() -> void:
 93: 	draw_circle(Vector2.ZERO, 18.0, COLOR_BODY)
 94: 	draw_circle(Vector2.ZERO, 10.0, COLOR_CORE)
 95: 	for i in 8:
 96: 		var dir := Vector2.from_angle(TAU * i / 8.0)
 97: 		draw_circle(dir * 24.0, 6.0, COLOR_RAY)
