=== autoload\sun_bank.gd ===
  1: extends Node
  2: 
  3: ## SunBank — Banco de sol (economía) (Fase 2).
  4: ##
  5: ## Autoload centralizado para el recurso "sol".
  6: ## Mantiene el total y emite cambios por EventBus:
  7: ##   - sun_changed(total)   -> HUD actualiza el contador
  8: ##   - sun_collected(n)     -> se recogió sol
  9: ##   - sun_spent(n)         -> se gastó sol (siembra, Fase 3)
 10: ##
 11: ## La Fase 3 usará can_afford()/spend() desde la lógica de siembra.
 12: 
 13: const STARTING_SUN := 50
 14: 
 15: var amount: int = 0
 16: 
 17: func _ready() -> void:
 18: 	amount = STARTING_SUN
 19: 	EventBus.sun_changed.emit(amount)
 20: 
 21: ## Añade sol (p. ej. al recoger un sol del cielo). Emite señales.
 22: func add(amount_added: int) -> void:
 23: 	if amount_added <= 0:
 24: 		return
 25: 	amount += amount_added
 26: 	EventBus.sun_collected.emit(amount_added)
 27: 	EventBus.sun_changed.emit(amount)
 28: 
 29: ## ¿Hay sol suficiente para pagar `cost`?
 30: func can_afford(cost: int) -> bool:
 31: 	return amount >= cost
 32: 
 33: ## Intenta gastar `cost` sol. Devuelve false si no alcanza (no descuenta).
 34: func spend(cost: int) -> bool:
 35: 	if cost <= 0:
 36: 		return true
 37: 	if not can_afford(cost):
 38: 		return false
 39: 	amount -= cost
 40: 	EventBus.sun_spent.emit(cost)
 41: 	EventBus.sun_changed.emit(amount)
 42: 	return true
========================================

