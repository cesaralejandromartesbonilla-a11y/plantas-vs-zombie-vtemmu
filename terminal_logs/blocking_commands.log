=== scenes\projectiles\pea.gd ===
  1: class_name Pea
  2: extends Area2D
  3: 
  4: ## Pea — 🟢 Guisante (Fase 4).
  5: ##
  6: ## Viaja por su fila (misma `row` en la que se disparó) hacia la derecha.
  7: ## Golpea al primer zombie de su carril que encuentre (detección por fila
  8: ## + rango en X, según la decisión de la sección 6 de la hoja de ruta).
  9: ##
 10: ## Si atraviesa todo el tablero sin impactar, se elimina (se marca para
 11: ## evitar doble impacto).
 12: 
 13: const SPEED := 420.0        # píxeles/segundo hacia la derecha
 14: const KILL_X := 1350.0      # fuera del tablero (1280+)
 15: 
 16: var row: int = 0
 17: var damage: int = 20
 18: var _dead: bool = false
 19: 
 20: func setup(p_row: int, p_damage: int) -> void:
 21: 	row = p_row
 22: 	damage = p_damage
 23: 
 24: func _process(delta: float) -> void:
 25: 	if _dead:
 26: 		return
 27: 	global_position.x += SPEED * delta
 28: 	_try_hit()
 29: 	if not _dead and global_position.x > KILL_X:
 30: 		queue_free()
 31: 
 32: ## Busca al zombie más cercano (menor X) en este carril y lo golpea.
 33: func _try_hit() -> void:
 34: 	var best: Node2D = null
 35: 	var best_x := INF
 36: 	for zombie in get_tree().get_nodes_in_group("zombies"):
 37: 		if not is_instance_valid(zombie):
 38: 			continue
 39: 		if zombie.row != row:
 40: 			continue
 41: 		var zx := zombie.global_position.x
 42: 		if zx <= global_position.x:
 43: 			continue
 44: 		# El guisante impacta cuando su centro alcanza el cuerpo del zombie.
 45: 		if zx - global_position.x > 26.0:
 46: 			continue
 47: 		if zx < best_x:
 48: 			best_x = zx
 49: 			best = zombie
 50: 	if best != null:
 51: 		_dead = true
 52: 		best.take_damage(damage)
 53: 		queue_free()
 54: 
 55: ## Placeholder visual: guisante verde.
 56: func _draw() -> void:
 57: 	draw_circle(Vector2.ZERO, 7.0, Color(0.35, 0.8, 0.3))
 58: 	draw_circle(Vector2(2.0, -2.0), 2.4, Color(0.6, 0.95, 0.5))
